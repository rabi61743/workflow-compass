# =============================================================================
# WMS Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and update the values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API base URL (without trailing slash)
VITE_API_URL=http://localhost:8000/api

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Application name displayed in the UI
VITE_APP_NAME=Workflow Management System

# Application environment (development, staging, production)
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable/disable Paperless-ngx integration
VITE_ENABLE_PAPERLESS=true

# Enable/disable file upload feature
VITE_ENABLE_FILE_UPLOAD=true

# Enable/disable real-time notifications
VITE_ENABLE_REALTIME=false

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking (production)
# VITE_SENTRY_DSN=https://your-sentry-dsn

# Analytics tracking ID (production)
# VITE_ANALYTICS_ID=G-XXXXXXXXXX
